# investclosure - Foreclosure property scraper
# Copy this to .env and fill in required values.
# All paths are configurable via INVESTCLOSURE_* env vars.

# =============================================================================
# Required
# =============================================================================

# 2captcha API key (required for solving reCAPTCHA on foreclosure sites)
TWO_CAPTCHA_API_KEY=your_2captcha_api_key_here

# =============================================================================
# Optional — Scraper Settings
# =============================================================================

# Proxy configuration (optional)
# Format: "hostname:port" — scrapers will use http://{proxy}
INVESTCLOSURE_PROXY=
INVESTCLOSURE_PROXY_ENABLED=true
INVESTCLOSURE_CAPTCHA_ENABLED=true

# ---- Dashboard serving (gunicorn) ----
# Socket the WSGI server binds inside the container. 0.0.0.0 keeps today's
# access path. "127.0.0.1:5001" is loopback-only (SSH tunnel in); see
# docker-compose.realip.yml for the pasta network, which makes the real client
# address survive instead of Podman's rewritten bridge IP.
INVESTCLOSURE_BIND=0.0.0.0:5001
INVESTCLOSURE_WORKERS=2
INVESTCLOSURE_THREADS=8
# Longest request gunicorn tolerates; server-side GIS tiles can take seconds.
INVESTCLOSURE_REQUEST_TIMEOUT=120
# How many reverse-proxy hops' X-Forwarded-For to believe. LEAVE AT 0 unless a
# proxy that SETS the header is the only thing that can reach the app — with 0,
# a client cannot forge its source address.
INVESTCLOSURE_TRUST_PROXY=0
# 1 = Werkzeug dev server instead of gunicorn (local debugging only).
INVESTCLOSURE_DEV_SERVER=0

# Filter thresholds
INVESTCLOSURE_MIN_ACRES=1.1
INVESTCLOSURE_MAX_ACRES=1000.0
INVESTCLOSURE_MAX_PRICE=0

# Rentals vertical rules (GA tax-sales near Atlanta; mountains thresholds
# do NOT apply to rentals rows). Distance from downtown Atlanta + the
# small-home market-rent band a zip must hit for its county to be scraped.
INVESTCLOSURE_RENT_RADIUS_MILES=100
INVESTCLOSURE_RENT_ORIGIN_LAT=33.7540
INVESTCLOSURE_RENT_ORIGIN_LON=-84.3905
INVESTCLOSURE_RENT_TARGET_MIN_RENT=800
INVESTCLOSURE_RENT_TARGET_MAX_RENT=1200
INVESTCLOSURE_RENT_MIN_RENT_LISTINGS=4
INVESTCLOSURE_RENT_MAX_MEDIAN_PRICE=250000

# =============================================================================
# Optional — Filesystem Paths
# =============================================================================

# Base directory for all data (DB, backups, logs)
INVESTCLOSURE_DATA_DIR=./data

# SQLite database path
INVESTCLOSURE_DB_PATH=./data/investclosure.db

# Directory for DB backups
INVESTCLOSURE_BACKUPS_DIR=./data/backups

# Directory for log files
INVESTCLOSURE_LOGS_DIR=./data/logs

# Cron run interval in minutes (only used when running with --cron flag)
# Default: 360 (6 hours). Set to a lower value (e.g., 60) for more frequent runs.
SCRAPE_INTERVAL=360

# =============================================================================
# Optional — Telegram Notifications (copied from realestate)
# =============================================================================

# Telegram Bot API (get from @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=false

# Public app URL linked from Telegram alerts (per-property "App" links go
# to <APP_URL>/property/<id>; reachable remotely here, dashboard has login)
INVESTCLOSURE_APP_URL=http://winmutt.duckdns.org:5001

# =============================================================================
# Optional — API Keys (back-pocket storage)
# =============================================================================

# RentCast API key — rentals vertical (zip-market rent screen + per-property
# rent AVM). Get one at rentcast.io/api. Used by
# `python3 -m scraper.rent_market_scan` (~one /markets call per GA zip per
# monthly refresh).
RENTCAST_API_KEY=

# Google Maps API key (for elevation / Maps enrichment — stored even if not active)
GOOGLE_MAPS_API_KEY=

# 2captcha browser/enterprise keys (stored for back-pocket use)
TWO_CAPTCHA_BROWSER_API_URL=
TWO_CAPTCHA_BROWSER_USER=
TWO_CAPTCHA_BROWSER_PASS=

# =============================================================================
# Optional — Site URL Overrides (rarely needed)
# =============================================================================

NCFORECLOSURES_BASE_URL=https://www.ncnotices.com
NCFORECLOSURES_CAPTCHA_SITE_KEY=6LeRyw8sAAAAAJRiqeOxNIyHIZ0c4y6sL-qWbt63

TNFORECLOSURES_BASE_URL=https://www.tnpublicnotice.com
TNFORECLOSURES_CAPTCHA_SITE_KEY=6LdtSg8sAAAAADTdRyZxJ2R2sS82pKALNMvMqSyL
